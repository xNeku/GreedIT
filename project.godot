; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="GreedIT"
config/description="ARPG cooperativo top-down: Terraria + Path of Exile."
run/main_scene="res://src/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Events="*res://src/autoload/events.gd"
GameFeel="*res://src/autoload/game_feel.gd"
Net="*res://src/autoload/net.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1920
window/size/window_height_override=1080
window/size/mode=2
window/stretch/mode="viewport"
window/stretch/aspect="expand"

