[layer_names]

2d_physics/layer_1="world"
2d_physics/layer_2="player"
2d_physics/layer_3="enemies"
2d_physics/layer_4="player_attacks"
2d_physics/layer_5="enemy_hurtbox"
2d_physics/layer_6="player_hurtbox"
2d_physics/layer_7="enemy_attacks"
2d_physics/layer_8="interactables"
3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="enemies"
3d_physics/layer_4="player_attacks"
3d_physics/layer_5="enemy_hurtbox"
3d_physics/layer_6="player_hurtbox"
3d_physics/layer_7="enemy_attacks"
3d_physics/layer_8="interactables"
2d_render/layer_1="default"
2d_render/layer_2="no_shadow"

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
2d/snap/snap_2d_vertices_to_pixel=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.07, 0.06, 0.08, 1)
